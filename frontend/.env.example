# ==========================================
# PocketLaw Frontend Environment Variables
# ==========================================

# For Local Development:
# Leave blank or point to local Flask server:
REACT_APP_API_URL=http://127.0.0.1:5001

# For Live Production Deployments (Vercel, Netlify, Cloudflare Pages):
# Set this variable in your hosting dashboard (e.g. Vercel -> Project Settings -> Environment Variables)
# pointing to your live backend URL (e.g., Render Web Service):
# REACT_APP_API_URL=https://your-pocketlaw-backend.onrender.com
